<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #161a21;
    --panel: #29313e;
    --line: #2d3542;
    --text: #e3e7ee;
    --muted: #9aa4b2;
    --accent: #7aa2f7;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Manrope", system-ui, sans-serif;
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  nav {
    position: sticky;
    top: 0;
    z-index: 1;
    background: rgba(22, 26, 33, .85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner, main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .brand { font-size: 1.2rem; font-weight: 800; letter-spacing: -.01em; }
  .links { display: flex; gap: 20px; }
  .links a { display: flex; align-items: center; gap: 6px; color: var(--muted); font-weight: 500; }
  .links a:hover { color: var(--accent); }
  .links svg { width: 18px; height: 18px; fill: currentColor; }
  main { padding-top: 56px; padding-bottom: 64px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color .15s;
  }
  .card:hover { border-color: var(--accent); }
  .logo {
    height: 170px;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo img { width: 100%; height: 100%; object-fit: contain; }
  .initial { font-size: 4rem; font-weight: 800; color: var(--muted); }
  .body { padding: 20px 22px 24px; }
  .card h2 { margin: 0 0 8px; font-size: 1.3rem; font-weight: 700; }
  .card p { margin: 0; color: var(--muted); line-height: 1.6; }
  @media (max-width: 480px) {
    .brand { font-size: 1rem; }
    .links span { display: none; }
  }
</style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <span class="brand">{{.Title}}</span>
    <div class="links">
      {{if .GitHub}}<a href="{{.GitHub}}" target="_blank" rel="noopener"><svg viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span>GitHub</span></a>{{end}}
      {{if .Email}}<a href="mailto:{{.Email}}"><svg viewBox="0 0 24 24"><path d="M2 4h20v16H2V4zm2 2v.5l8 5 8-5V6H4zm16 2.85-8 5-8-5V18h16V8.85z"/></svg><span>Email</span></a>{{end}}
    </div>
  </div>
</nav>
<main>
  <div class="grid">
    {{range .Apps}}
    <a class="card" href="{{.URL}}" target="_blank" rel="noopener">
      <div class="logo">{{if .Logo}}<img src="{{.Logo}}" alt="{{.Name}} logo" loading="lazy">{{else}}<span class="initial">{{slice .Name 0 1}}</span>{{end}}</div>
      <div class="body">
        <h2>{{.Name}}</h2>
        <p>{{.Description}}</p>
      </div>
    </a>
    {{end}}
  </div>
</main>
</body>
</html>
